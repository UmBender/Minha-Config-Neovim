{
  "fori": {
    "prefix": "fori",
    "body": ["for (int ${1:i} = ${2:0}; $1 < ${3:n}; $1++) {", "\t$0", "}"],
    "description": "Indexed for loop"
  },
  "all": {
    "prefix": "all",
    "body": ["${1:v}.begin(), $1.end()"],
    "description": "begin(), end() pair"
  },
  "vread": {
    "prefix": "vread",
    "body": ["vector<${1:int}> ${2:a}(${3:n});", "for (auto &x : $2) cin >> x;"],
    "description": "Read a vector"
  },
  "yesno": {
    "prefix": "yesno",
    "body": ["cout << (${1:ok} ? \"YES\" : \"NO\") << '\\n';"],
    "description": "Print YES/NO"
  }
}
